# Настройки подключения к серверу и оборудованию
host=127.0.0.1
port=2325
user=Server

# Ключ по умолчанию для чистых карт Mifare
factory_key=ffffffffffff

# Режим работы:
# 1 - Ручной режим
# 2 - Автоматический режим (Диспенсер MT166 + MT625)
mode=2

# Тип считывателя для ручного режима:
# 1 - Omnikey (USB PC/SC)
# 2 - MT625 (RS-232 COM-порт)
reader_type=1

# COM-порты (можно указывать номер, например 10, или COM10)
dispenser_port=COM10
mt625_port=COM12

# Размер пачки карт для отправки в базу данных MS SQL
batch_size=10
